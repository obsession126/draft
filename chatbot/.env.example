# Copy this file to .env and provide your own local Google AI Studio key.
GEMINI_API_KEY=replace-with-your-google-ai-studio-key
GEMINI_MODEL=gemini-3.5-flash-lite

# The chatbot server reads authenticated data from the existing Django API.
MISSION_API_BASE_URL=http://127.0.0.1:8000
CHATBOT_PORT=8766
